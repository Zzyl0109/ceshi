
@torch.no_grad()
def interpolate_psf_xy_gpu(
    target_xy,
    centers,
    psfs,
    num_points=36,
    sigma=None,
    ridge=1e-6
):
    """
    距离加权二次多项式空间插值

    target_xy: [B, 2]
    centers:   [N, 2]
    psfs:      [N, K, K]

    return:    [B, K, K]
    """

    B = target_xy.shape[0]
    K = psfs.shape[-1]

    # --------------------------------------------------
    # 1. 选取最近的 num_points 个采样中心
    # --------------------------------------------------
    dist = torch.cdist(target_xy, centers)

    dist_selected, indices = torch.topk(
        dist,
        k=num_points,
        dim=1,
        largest=False,
        sorted=True
    )

    centers_selected = centers[indices]   # [B, N, 2]
    psfs_selected = psfs[indices]         # [B, N, K, K]

    # --------------------------------------------------
    # 2. 构造局部坐标
    # --------------------------------------------------
    dx = centers_selected[..., 0] - target_xy[:, None, 0]
    dy = centers_selected[..., 1] - target_xy[:, None, 1]

    # 二次多项式
    A = torch.stack([
        torch.ones_like(dx),
        dx,
        dy,
        dx * dx,
        dx * dy,
        dy * dy
    ], dim=-1)  # [B, N, 6]

    # --------------------------------------------------
    # 3. 根据距离构造权重
    # --------------------------------------------------
    if sigma is None:
        sigma = dist_selected[:, -1:].clamp_min(1e-6)

    weights = torch.exp(
        -0.5 * (dist_selected / sigma) ** 2
    )

    # 避免权重过小
    weights = weights.clamp_min(1e-6)

    # --------------------------------------------------
    # 4. 加权最小二乘
    # --------------------------------------------------
    values = psfs_selected.reshape(B, num_points, -1)

    # A^T W A
    Aw = A * weights.unsqueeze(-1)

    ATA = A.transpose(1, 2) @ Aw

    # A^T W V
    ATV = A.transpose(1, 2) @ (
        values * weights.unsqueeze(-1)
    )

    # 正则化
    eye = torch.eye(
        6,
        device=A.device,
        dtype=A.dtype
    ).unsqueeze(0)

    ATA = ATA + ridge * eye

    coeff = torch.linalg.solve(ATA, ATV)

    # --------------------------------------------------
    # 5. 目标位置为局部坐标(0,0)，取常数项
    # --------------------------------------------------
    result = coeff[:, 0, :].reshape(B, K, K)

    return result
