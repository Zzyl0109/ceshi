
import torch
import torch.nn as nn
import torch.nn.functional as F


# ============================================================
# 基础模块
# ============================================================

class ConvBlock(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()

        self.conv1 = nn.Conv2d(
            in_ch, out_ch,
            kernel_size=3,
            padding=1,
            bias=False
        )
        self.norm1 = nn.GroupNorm(4, out_ch)

        self.conv2 = nn.Conv2d(
            out_ch, out_ch,
            kernel_size=3,
            padding=1,
            bias=False
        )
        self.norm2 = nn.GroupNorm(4, out_ch)

        self.act = nn.GELU()

    def forward(self, x):
        x = self.act(self.norm1(self.conv1(x)))
        x = self.act(self.norm2(self.conv2(x)))
        return x


# ============================================================
# Patch卷积编码器
#
# 输入:
# [B, N*2, P, P]
#
# 内部按patch分组卷积
# 不同patch使用相同卷积权重
#
# 输出:
# [B, N*C, P/3, P/3]
# ============================================================

class PatchEncoder(nn.Module):

    def __init__(
        self,
        in_ch=2,
        base_ch=16,
        out_ch=8
    ):
        super().__init__()

        self.in_ch = in_ch
        self.base_ch = base_ch
        self.out_ch = out_ch

        self.down = nn.Conv2d(
            in_ch,
            base_ch,
            kernel_size=3,
            stride=3,
            padding=1,
            bias=False
        )

        self.norm1 = nn.GroupNorm(4, base_ch)

        self.refine = nn.Conv2d(
            base_ch,
            out_ch,
            kernel_size=3,
            padding=1,
            bias=False
        )

        self.norm2 = nn.GroupNorm(4, out_ch)

        self.act = nn.GELU()

    @staticmethod
    def grouped_conv(x, conv, n):

        weight = conv.weight.repeat(
            n, 1, 1, 1
        )

        bias = None

        if conv.bias is not None:
            bias = conv.bias.repeat(n)

        return F.conv2d(
            x,
            weight,
            bias,
            stride=conv.stride,
            padding=conv.padding,
            dilation=conv.dilation,
            groups=n
        )

    @staticmethod
    def grouped_norm(x, norm, B, N, C):

        _, _, H, W = x.shape

        x = x.reshape(B, N, C, H, W)
        x = x.reshape(B * N, C, H, W)

        x = norm(x)

        return x.reshape(B, N * C, H, W)

    def forward(self, x):

        B, total_ch, H, W = x.shape

        N = total_ch // self.in_ch

        # 第一次下采样
        x = self.grouped_conv(
            x, self.down, N
        )

        x = self.grouped_norm(
            x, self.norm1,
            B, N, self.base_ch
        )

        x = self.act(x)

        # 特征提取
        x = self.grouped_conv(
            x, self.refine, N
        )

        x = self.grouped_norm(
            x, self.norm2,
            B, N, self.out_ch
        )

        x = self.act(x)

        return x


# ============================================================
# 按通道切块
#
# [B,1,H,W]
#     ->
# [B,N,P,P]
# ============================================================

def crop_to_channels(x, patch_size):

    B, C, H, W = x.shape

    assert H % patch_size == 0
    assert W % patch_size == 0

    patches = F.unfold(
        x,
        kernel_size=patch_size,
        stride=patch_size
    )

    N = patches.shape[-1]

    patches = patches.transpose(1, 2)

    patches = patches.reshape(
        B,
        N * C,
        patch_size,
        patch_size
    )

    return patches


# ============================================================
# Patch通道重新组织
#
# [B,N*C,H,W]
#     ->
# [B,N,C,H,W]
# ============================================================

def split_patch_channels(x, N, C):

    B, _, H, W = x.shape

    return x.reshape(
        B, N, C, H, W
    )


# ============================================================
# 对应patch特征融合
#
# 输入:
# [B,N,C,H,W]
# [B,N,C,H,W]
#
# 输出:
# [B,N,F,H,W]
# ============================================================

class PatchFusion(nn.Module):

    def __init__(self, in_ch, out_ch):
        super().__init__()

        self.block = ConvBlock(
            in_ch * 2,
            out_ch
        )

    def forward(self, x1, x2):

        B, N, C, H, W = x1.shape

        x = torch.cat(
            [x1, x2],
            dim=2
        )

        x = x.reshape(
            B * N,
            C * 2,
            H, W
        )

        x = self.block(x)

        return x.reshape(
            B, N,
            x.shape[1],
            H, W
        )


# ============================================================
# Patch解码器
#
# 输入:
# [B,N,C,204,204]
#
# 输出:
# [B,N,2,612,612]
#
# 两个输出通道:
# K、B
# ============================================================

class PatchDecoder(nn.Module):

    def __init__(self, in_ch=32, decoder_ch=16):
        super().__init__()

        self.block = ConvBlock(
            in_ch,
            decoder_ch
        )

        self.up = nn.ConvTranspose2d(
            decoder_ch,
            decoder_ch,
            kernel_size=3,
            stride=3,
            padding=0
        )

        self.refine = ConvBlock(
            decoder_ch,
            decoder_ch
        )

        self.head = nn.Conv2d(
            decoder_ch,
            2,
            kernel_size=1
        )

        # 初始化 K=1，B=0
        nn.init.zeros_(self.head.weight)
        nn.init.zeros_(self.head.bias)

    def forward(self, x):

        B, N, C, H, W = x.shape

        x = x.reshape(
            B * N, C, H, W
        )

        x = self.block(x)

        x = F.gelu(self.up(x))

        x = self.refine(x)

        x = self.head(x)

        x = x.reshape(
            B, N, 2,
            x.shape[-2],
            x.shape[-1]
        )

        return x


# ============================================================
# Patch重新拼回原图
#
# [B,N,C,P,P]
#     ->
# [B,C,H,W]
# ============================================================

def patches_to_image(
    patches,
    grid_h,
    grid_w
):

    B, N, C, P, _ = patches.shape

    assert N == grid_h * grid_w

    x = patches.reshape(
        B,
        grid_h,
        grid_w,
        C,
        P,
        P
    )

    x = x.permute(
        0, 3, 1, 4, 2, 5
    ).contiguous()

    x = x.reshape(
        B,
        C,
        grid_h * P,
        grid_w * P
    )

    return x


# ============================================================
# 完整网络
# ============================================================

class MultiScaleDepthNet(nn.Module):

    def __init__(
        self,
        feature_ch=8,
        fusion_ch=32
    ):
        super().__init__()

        # 高尺度独立编码器
        self.encoder_fine = PatchEncoder(
            in_ch=2,
            base_ch=16,
            out_ch=feature_ch
        )

        # 低尺度独立编码器
        self.encoder_coarse = PatchEncoder(
            in_ch=2,
            base_ch=16,
            out_ch=feature_ch
        )

        # 高低尺度特征融合
        self.fusion = PatchFusion(
            feature_ch,
            fusion_ch
        )

        # 解码器
        self.decoder = PatchDecoder(
            in_ch=fusion_ch,
            decoder_ch=16
        )

    def forward(self, blur, da):

        B, _, H, W = blur.shape

        assert H == 3672 and W == 5496, (
            "当前版本按照3672x5496设计"
        )

        assert da.shape == blur.shape, (
            "DA图必须与模糊图具有相同尺寸"
        )

        # ====================================================
        # 1. 原始尺度切块
        # ====================================================

        # 612 x 612
        y1 = crop_to_channels(
            blur, 612
        )

        da1 = crop_to_channels(
            da, 612
        )

        # [B,108,612,612]
        x1 = torch.cat(
            [y1, da1],
            dim=1
        )

        # 6 x 9 = 54个patch
        N = 54

        # ====================================================
        # 2. 原始尺度特征提取
        # ====================================================

        feat1 = self.encoder_fine(x1)

        # [B,54*8,204,204]
        feat1 = split_patch_channels(
            feat1, N, 8
        )

        # [B,54,8,204,204]

        # ====================================================
        # 3. 下采样4倍
        # ====================================================

        blur4 = F.interpolate(
            blur,
            size=(918, 1374),
            mode="area"
        )

        da4 = F.interpolate(
            da,
            size=(918, 1374),
            mode="area"
        )

        # ====================================================
        # 4. 低尺度切块
        # ====================================================

        # 153 x 153
        y2 = crop_to_channels(
            blur4, 153
        )

        da2 = crop_to_channels(
            da4, 153
        )

        # [B,108,153,153]
        x2 = torch.cat(
            [y2, da2],
            dim=1
        )

        # ====================================================
        # 5. 低尺度特征提取
        # ====================================================

        feat2 = self.encoder_coarse(x2)

        # [B,54*8,51,51]
        feat2 = split_patch_channels(
            feat2, N, 8
        )

        # [B,54,8,51,51]

        # ====================================================
        # 6. 低尺度特征上采样4倍
        # ====================================================

        feat2 = feat2.reshape(
            B * N,
            8,
            51,
            51
        )

        feat2 = F.interpolate(
            feat2,
            size=(204, 204),
            mode="bilinear",
            align_corners=False
        )

        feat2 = feat2.reshape(
            B, N, 8, 204, 204
        )

        # ====================================================
        # 7. 对应patch融合
        # ====================================================

        fused = self.fusion(
            feat1,
            feat2
        )

        # [B,54,32,204,204]

        # ====================================================
        # 8. Patch解码
        # ====================================================

        pred_patches = self.decoder(
            fused
        )

        # [B,54,2,612,612]

        # ====================================================
        # 9. 按照原来的空间位置拼回整图
        # ====================================================

        pred = patches_to_image(
            pred_patches,
            grid_h=6,
            grid_w=9
        )

        # [B,2,3672,5496]

        k_delta = pred[:, 0:1]
        b_map = pred[:, 1:2]

        K = 1.0 + k_delta

        depth = K * da + b_map

        return {
            "depth": depth,
            "K": K,
            "B": b_map
        }
