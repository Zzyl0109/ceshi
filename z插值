import torch
import torch.nn.functional as F


# ============================================================
# 计算对称正定矩阵的幂
# ============================================================

def matrix_power_spd(matrix, power, eps=1e-6):
    """
    matrix: [B, 2, 2]
    power: 0.5 / -0.5 / etc.
    """
    matrix = 0.5 * (matrix + matrix.transpose(-1, -2))

    eigvals, eigvecs = torch.linalg.eigh(matrix)
    eigvals = eigvals.clamp_min(eps)

    return (
        eigvecs * eigvals.pow(power).unsqueeze(-2)
    ) @ eigvecs.transpose(-1, -2)


def matrix_log_spd(matrix, eps=1e-6):
    matrix = 0.5 * (matrix + matrix.transpose(-1, -2))

    eigvals, eigvecs = torch.linalg.eigh(matrix)
    eigvals = eigvals.clamp_min(eps)

    return (
        eigvecs * torch.log(eigvals).unsqueeze(-2)
    ) @ eigvecs.transpose(-1, -2)


def matrix_exp_sym(matrix):
    matrix = 0.5 * (matrix + matrix.transpose(-1, -2))

    eigvals, eigvecs = torch.linalg.eigh(matrix)

    return (
        eigvecs * torch.exp(eigvals).unsqueeze(-2)
    ) @ eigvecs.transpose(-1, -2)


# ============================================================
# 计算 PSF 的质心和二阶矩
# ============================================================

@torch.no_grad()
def calculate_psf_moments(psf, eps=1e-8):
    """
    psf: [B, H, W]

    return:
        center: [B, 2]       (x, y)
        covariance: [B, 2, 2]
        energy: [B]
    """

    B, H, W = psf.shape

    # 只使用非负强度
    psf = psf.clamp_min(0)

    energy = psf.sum(dim=(-2, -1)).clamp_min(eps)

    prob = psf / energy[:, None, None]

    yy, xx = torch.meshgrid(
        torch.arange(H, device=psf.device, dtype=psf.dtype),
        torch.arange(W, device=psf.device, dtype=psf.dtype),
        indexing="ij"
    )

    cx = (prob * xx).sum(dim=(-2, -1))
    cy = (prob * yy).sum(dim=(-2, -1))

    dx = xx[None] - cx[:, None, None]
    dy = yy[None] - cy[:, None, None]

    cxx = (prob * dx * dx).sum(dim=(-2, -1))
    cyy = (prob * dy * dy).sum(dim=(-2, -1))
    cxy = (prob * dx * dy).sum(dim=(-2, -1))

    covariance = torch.stack([
        torch.stack([cxx, cxy], dim=-1),
        torch.stack([cxy, cyy], dim=-1)
    ], dim=-2)

    # 防止矩阵退化
    eye = torch.eye(
        2, device=psf.device, dtype=psf.dtype
    ).unsqueeze(0)

    covariance = covariance + eye * 1e-4

    center = torch.stack([cx, cy], dim=-1)

    return center, covariance, energy


# ============================================================
# 构造 grid_sample 所需的坐标
# ============================================================

def make_sampling_grid(src_x, src_y, H, W):
    """
    src_x, src_y: [B, H, W]
    """

    gx = 2.0 * src_x / max(W - 1, 1) - 1.0
    gy = 2.0 * src_y / max(H - 1, 1) - 1.0

    return torch.stack([gx, gy], dim=-1)


# ============================================================
# 形态归一化：四张 PSF 统一到参考二阶矩
# ============================================================

@torch.no_grad()
def normalize_psf_morphology(psf_selected):
    """
    psf_selected: [B, 4, H, W]

    return:
        aligned_psfs: [B, 4, H, W]
        centers:      [B, 4, 2]
        covariances:  [B, 4, 2, 2]
        energies:     [B, 4]
        ref_center:   [B, 2]
        ref_cov:      [B, 2, 2]
    """

    B, K, H, W = psf_selected.shape

    centers = []
    covariances = []
    energies = []

    # 分别计算四个深度的形态参数
    for k in range(K):

        center, cov, energy = calculate_psf_moments(
            psf_selected[:, k]
        )

        centers.append(center)
        covariances.append(cov)
        energies.append(energy)

    centers = torch.stack(centers, dim=1)
    covariances = torch.stack(covariances, dim=1)
    energies = torch.stack(energies, dim=1)

    # 参考中心和参考形态
    ref_center = centers.mean(dim=1)
    ref_cov = covariances.mean(dim=1)

    ref_sqrt = matrix_power_spd(ref_cov, 0.5)
    ref_invsqrt = matrix_power_spd(ref_cov, -0.5)

    # 坐标网格
    yy, xx = torch.meshgrid(
        torch.arange(H, device=psf_selected.device,
                     dtype=psf_selected.dtype),
        torch.arange(W, device=psf_selected.device,
                     dtype=psf_selected.dtype),
        indexing="ij"
    )

    xx = xx[None].expand(B, -1, -1)
    yy = yy[None].expand(B, -1, -1)

    delta_ref = torch.stack([
        xx - ref_center[:, 0, None, None],
        yy - ref_center[:, 1, None, None]
    ], dim=-1)

    aligned_psfs = []

    for k in range(K):

        # 当前 PSF 的逆变换矩阵
        cov_sqrt = matrix_power_spd(
            covariances[:, k], 0.5
        )

        transform_inv = cov_sqrt @ ref_invsqrt

        # 从统一参考坐标映射回原始 PSF 坐标
        delta_src = torch.einsum(
            "bij,bhwj->bhwi",
            transform_inv,
            delta_ref
        )

        src_x = delta_src[..., 0] + centers[:, k, 0, None, None]
        src_y = delta_src[..., 1] + centers[:, k, 1, None, None]

        grid = make_sampling_grid(src_x, src_y, H, W)

        # 先归一化能量
        src = psf_selected[:, k].clamp_min(0)
        src_energy = src.sum(dim=(-2, -1)).clamp_min
